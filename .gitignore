*.yuv
# Raw test sequences (y4m) are huge and reproducible from their source URLs
# (e.g. src/samples/aomctc_test_set/a1_4k_source.txt). Never commit them.
*.y4m
*.crdownload
__pycache__/
*.pyc
opsnr.stt

# ML training artifacts (reproducible from scripts + dataset; kept out of git),
# EXCEPT the deployed distilled student, which is the goal artifact.
results/models/
!results/models/student_real/
!results/models/student_real/**
*.npz
# .pt weights are large; keep them out of git (LFS/external), but allow the
# tiny distilled student checkpoint through the models exception above.
*.pt
!results/models/student_real/*.pt
.venv-ml/

# Dataset payloads are huge (dataset_h9 ~135 GB) and reproducible from the
# instrumented encoder + scripts + source YUV. Never commit them to git.
# Only manifests / metadata are tracked.
results/dataset/*.bin
results/dataset/*.pkl
results/dataset/blocks/
results/dataset_h9/
results/dataset_new/
results/benchmark/_work/
results/benchmark/**/_work/
results/benchmark/h8_probs/
# Encoded bitstreams from benchmark runs are large and deterministically
# reproducible from the source y4m + scripts; only the measured CSV/tex/log
# summaries are kept in git.
*.ivf

# Transient build/training logs
logs/
