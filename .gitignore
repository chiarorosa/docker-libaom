*.yuv
# Raw test sequences (y4m) are huge and reproducible from their source URLs
# (e.g. src/samples/aomctc_test_set/a1_4k_source.txt). Never commit them.
*.y4m
*.crdownload
__pycache__/
*.pyc
opsnr.stt

# ML training artifacts (reproducible from scripts + dataset; kept out of git),
# EXCEPT the deployed distilled student, which is the goal artifact.
results/models/
!results/models/student_real/
!results/models/student_real/**
*.npz
# .pt weights are large; keep them out of git (LFS/external), but allow the
# tiny distilled student checkpoint through the models exception above.
*.pt
!results/models/student_real/*.pt
.venv-ml/

# Dataset payloads are huge (dataset_h9 ~31 GB of .pkl) and reproducible from the
# instrumented encoder + scripts + source YUV. Never commit them to git.
# Only manifests / metadata are tracked.
results/dataset/*.bin
results/dataset/*.pkl
results/dataset/blocks/
# Note: the pattern must exclude the *contents* (trailing /*), not the directory
# itself -- git never descends into an excluded directory, so a `!` negation
# under `results/dataset_h9/` would be unreachable.
results/dataset_h9/*
results/dataset_new/
# ...except the small derived metadata: the provenance ledger and the label
# histogram (~145 KB total) are the reproducibility record of the dataset.
!results/dataset_h9/manifest.csv
!results/dataset_h9/label_histogram.csv
!results/dataset_h9/label_distribution.md
results/benchmark/_work/
results/benchmark/**/_work/
results/benchmark/h8_probs/
# Same class as h8_probs: per-node probability dumps for replay/calibration,
# regenerable from the model + YUV.
results/benchmark/gnn_probs/
# C1 partition-timing dumps: large per-node CSVs (~34MB) regenerable from the
# instrumented build (CONFIG_COLLECT_PARTITION_STATS) + YUV; only the analysis
# doc keeps the numbers.
results/benchmark/partstats*/
# H9d probes (envelope, marginal pos-NONE, curva tau): .obu + raw.csv,
# regenerable dos binarios libaom_extoff / libaom_extoff_ml.
results/benchmark/h9d_*/
results/benchmark/c2_levels/
results/benchmark/c5_finetau/
# Encoded bitstreams from benchmark runs are large and deterministically
# reproducible from the source y4m + scripts; only the measured CSV/tex/log
# summaries are kept in git.
*.ivf

# Transient build/training logs
logs/
results/benchmark/gnn_replay/_work/
results/benchmark/gnn_frontier/_work/
